{
  "sourceLanguage": "en",
  "strings": {
    "Allow access": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave de API"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        }
      }
    },
    "Add an API key in Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma chave de API nos Ajustes."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar"
          }
        }
      }
    },
    "Captures the active window when you press the shortcut. Takes effect after relaunching Feather.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura a janela ativa quando você pressiona o atalho. Passa a valer depois de reabrir o Feather."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurar Atualizações…"
          }
        }
      }
    },
    "Choose how Feather gets its replies. You can change this later in Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como o Feather obtém as respostas. Você pode mudar isso depois nas Configurações."
          }
        }
      }
    },
    "Click the box below, then press %@. Say what you want, and Feather writes it here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na caixa abaixo e aperte %@. Diga o que você quer e o Feather escreve aqui."
          }
        }
      }
    },
    "Connect a provider": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um provedor"
          }
        }
      }
    },
    "Connect a provider to continue.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um provedor para continuar."
          }
        }
      }
    },
    "Do not use em dashes.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use travessões."
          }
        }
      }
    },
    "Do not use emojis.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use emojis."
          }
        }
      }
    },
    "Feather follows these in every reply. Write your own or add a suggestion.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Feather segue estas instruções em todas as respostas. Escreva as suas ou adicione uma sugestão."
          }
        }
      }
    },
    "For example: Write in a friendly tone and keep replies short.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo: Escreva em tom amigável e mantenha as respostas curtas."
          }
        }
      }
    },
    "Friendly tone": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom amigável"
          }
        }
      }
    },
    "Keep it short": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja breve"
          }
        }
      }
    },
    "Keep replies short and to the point.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as respostas curtas e diretas."
          }
        }
      }
    },
    "No em dashes": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem travessões"
          }
        }
      }
    },
    "No emojis": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem emojis"
          }
        }
      }
    },
    "Open Feather at login": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o Feather ao ligar o computador"
          }
        }
      }
    },
    "Starts Feather in the background when you sign in to your computer.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o Feather em segundo plano quando você entra no computador."
          }
        }
      }
    },
