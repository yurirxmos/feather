      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar"
          }
        }
      }
    },
    "Press a shortcut anywhere. Feather reads what is on your screen, writes a reply, and pastes it into the field you are typing in.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperte um atalho em qualquer lugar. O Feather lê o que está na sua tela, escreve uma resposta e cola no campo em que você está digitando."
          }
        }
      }
    },
    "Show Welcome Guide…": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar guia de boas-vindas…"
