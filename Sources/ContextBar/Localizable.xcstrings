      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o Context Bar"
          }
        }
      }
    },
    "Open Context Bar (%@)": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o Context Bar (%@)"
          }
        }
      }
    },
