      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade"
          }
        }
      }
    },
    "Add an API key in Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma chave de API nos Ajustes."
          }
        }
      }
    },
    "Anthropic": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic"
          }
        }
      }
    },
    "Base URL": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "URL base"
          }
        }
      }
    },
    "Captures the active window when you press the shortcut. Takes effect after relaunching Context Bar.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura a janela ativa quando você pressiona o atalho. Passa a valer depois de reabrir o Context Bar."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar"
          }
        }
      }
    },
