      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalho"
          }
        }
      }
    },
    "The base URL in Settings is not valid.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL base nos Ajustes não é válida."
          }
        }
      }
    },
    "The model declined this request.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo recusou esta solicitação."
          }
        }
      }
    },
    "What do you want to write?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você quer escrever?"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela"
          }
        }
      }
    },
    "Works with OpenAI, OpenRouter, Groq, Ollama (http://localhost:11434/v1), LM Studio, and any server that speaks /chat/completions. Pick a model that accepts images to use the window screenshot.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com OpenAI, OpenRouter, Groq, Ollama (http://localhost:11434/v1), LM Studio e qualquer servidor que fale /chat/completions. Escolha um modelo que aceite imagens para usar a captura da janela."
          }
        }
      }
    },
    "Your key is stored in the macOS Keychain.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave fica guardada no Keychain do macOS."
          }
        }
      }
    }
  },
  "version": "1.0"
}
